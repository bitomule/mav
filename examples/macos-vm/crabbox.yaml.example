jobs:
  mav-macos:
    provider: tart
    target: macos
    idleTimeout: 30m
    # Sin hydrate: Actions hydration solo funciona en Linux, y en un target
    # macOS crabbox lo deja en un `run` directo de todas formas.
    shell: true
    command: >
      export PATH=/usr/local/bin:/opt/homebrew/bin:$PATH &&
      mav doctor &&
      mav --profile mac run flows/smoke.yaml
    stop: always
